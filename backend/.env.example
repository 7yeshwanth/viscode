# VisCode Backend Environment Variables
# Copy this file to .env and fill in your values

# ── AI Provider Configuration ──
# API Key / Bearer Token (required)
OPENAI_API_KEY=sk-your-key-here

# Base URL (optional — leave empty for default api.openai.com)
# Use this for custom endpoints, proxies, or compatible APIs
# Examples:
#   OpenAI (default): (leave empty)
#   Azure:    https://your-resource.openai.azure.com/openai/deployments/your-deployment
#   Claude:   https://api.anthropic.com/v1
#   F5 Proxy: https://f5ai.pd.f5net.com/api
#   Gemini:   https://generativelanguage.googleapis.com/v1beta
OPENAI_BASE_URL=

# AI Models per analysis pass
# Adjust model names based on your provider
#
# ── OpenAI Models ──
# OPENAI_MODEL_PASS1=gpt-4.1-mini
# OPENAI_MODEL_PASS2=gpt-4.1
# OPENAI_MODEL_PASS3=gpt-4.1
#
# ── Claude Models (via OpenAI-compatible proxy) ──
# OPENAI_MODEL_PASS1=claude-sonnet-4-20250514
# OPENAI_MODEL_PASS2=claude-sonnet-4-20250514
# OPENAI_MODEL_PASS3=claude-sonnet-4-20250514
#
# ── Gemini Models ──
# OPENAI_MODEL_PASS1=gemini-2.5-flash
# OPENAI_MODEL_PASS2=gemini-2.5-pro
# OPENAI_MODEL_PASS3=gemini-2.5-pro
#
# Defaults (OpenAI):
OPENAI_MODEL_PASS1=gpt-4.1-mini
OPENAI_MODEL_PASS2=gpt-4.1
OPENAI_MODEL_PASS3=gpt-4.1

# ── Concurrency ──
# Max simultaneous AI API calls (reduce for rate-limited providers)
MAX_CONCURRENT_CALLS=5

# ── File Limits ──
# Files larger than this are skipped
MAX_FILE_LINES=5000

# ── Cache ──
# Cache directory (relative to project root or absolute)
CACHE_DIR=.viscode_cache

# ── Security ──
# Allowed base paths for filesystem sandboxing (comma-separated)
ALLOWED_PATHS=/Users,/home,/Volumes

# ── Server ──
HOST=0.0.0.0
PORT=8000
