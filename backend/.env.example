# VisCode Backend Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-key-here

# AI Models per analysis pass
# Pass 1 (per-file): cheaper model is fine
OPENAI_MODEL_PASS1=gpt-4.1-mini
# Pass 2 (cross-file relationships): needs deeper reasoning
OPENAI_MODEL_PASS2=gpt-4.1
# Pass 3 (architecture summary): needs high-level synthesis
OPENAI_MODEL_PASS3=gpt-4.1

# Concurrency: max simultaneous OpenAI API calls
MAX_CONCURRENT_CALLS=5

# Max file size (lines) — files larger than this are skipped
MAX_FILE_LINES=5000

# Cache directory (relative to project root or absolute)
CACHE_DIR=.viscode_cache

# Allowed base paths for security sandboxing (comma-separated)
ALLOWED_PATHS=/Users,/home,/Volumes

# Server settings
HOST=0.0.0.0
PORT=8000
